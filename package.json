{
  "name": "billcrafter",
  "version": "0.1.0",
  "private": true,
  "description": "BillCrafter — free invoice generator (Next.js, deployable to Cloudflare)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy && (npm run indexnow || true)",
    "indexnow": "node scripts/indexnow.mjs",
    "start": "next start",
    "lint": "next lint",
    "og": "node scripts/og-manifest.mjs > /tmp/og-manifest.json && python3 scripts/render-og.py /tmp/og-manifest.json public/og",
    "steps": "python3 scripts/render-steps.py public/steps",
    "images": "npm run og && npm run steps && npm run anatomy",
    "anatomy": "python3 scripts/render-anatomy.py public/anatomy"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "html2pdf.js": "0.10.2",
    "next": "^15.5.18",
    "pdf-lib": "^1.17.1",
    "qrcode-generator": "^1.4.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "signature_pad": "^5.1.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.40",
    "tailwindcss": "3.4.7",
    "wrangler": "^4.105.0"
  }
}
